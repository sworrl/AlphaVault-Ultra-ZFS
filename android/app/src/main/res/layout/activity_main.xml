<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/av_bg">

    <!-- Floating Top Bar (Immersive Full Screen Canvas) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_title"
                android:textColor="@color/av_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/av_cyan"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cyber_card"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/badge_cascade"
            android:textColor="@color/av_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/av_text_secondary"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Main Panel Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/floatingDockContainer"
        android:layout_below="@id/topBar">

        <!-- VAULT PANEL: only the hidden files in the FLAC volume (main view) -->
        <ScrollView
            android:id="@+id/panelVault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/vault_files_header"
                    android:textColor="@color/av_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVaultSort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:padding="4dp"
                    android:text="@string/vault_files_sub"
                    android:textColor="@color/av_text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddVaultFile"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_neon_button"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_encrypt_vault"
                    android:textColor="@color/av_bg"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/vaultFileList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEmptyVault"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_cyber_card"
                        android:gravity="center"
                        android:text="@string/vault_empty"
                        android:textColor="@color/av_text_disabled"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- DISKS PANEL: RAID manager - storage, pool, and the FLAC carriers -->
        <ScrollView
            android:id="@+id/panelDisks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- RAID-Z2 & Hot Spare Pool Glass Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_cyber_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_pool_title"
                        android:textColor="@color/av_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVaultStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/vault_pool_subtitle"
                        android:textColor="@color/av_cyan"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/storageBar"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_bar_track"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <View
                            android:id="@+id/barUsed"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0"
                            android:background="@drawable/bg_bar_used" />

                        <View
                            android:id="@+id/barFree"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStorageDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/storage_scanning"
                        android:textColor="@color/av_text_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rgPoolMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbAutoLibrary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/pool_mode_auto"
                            android:textColor="@color/av_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbManualDisks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pool_mode_manual"
                            android:textColor="@color/av_text_secondary"
                            android:textSize="13sp" />
                    </RadioGroup>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnScanVault"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_keypad_button"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_auto_discover"
                    android:textColor="@color/av_cyan"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/pool_disks_header"
                    android:textColor="@color/av_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/poolDiskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEmptyDisks"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_cyber_card"
                        android:gravity="center"
                        android:text="@string/disks_empty"
                        android:textColor="@color/av_text_disabled"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Stego Inspector Panel with 60 FPS Visualizer -->
        <ScrollView
            android:id="@+id/panelStego"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stego_title"
                    android:textColor="@color/av_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Custom 60 FPS Stego Visualizer View -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/av_surface"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/av_cyan"
                    app:strokeWidth="1.5dp">

                    <com.alphasteg.pro.ui.StegoVisualizerView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/av_surface" />

                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSelectFlac"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_keypad_button"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_select_flac"
                    android:textColor="@color/av_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedFlac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_card"
                    android:padding="14dp"
                    android:text="@string/stego_none_selected"
                    android:textColor="@color/av_text_secondary" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnInspectTrack"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_neon_button"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_inspect_track"
                    android:textColor="@color/av_bg"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- Server Panel -->
        <LinearLayout
            android:id="@+id/panelServer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_title"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/server_desc"
                android:textColor="@color/av_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_switch"
                android:textColor="@color/av_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_cyber_card"
                android:fontFamily="monospace"
                android:padding="16dp"
                android:text="@string/server_status_stopped"
                android:textColor="@color/av_cyan"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Floating Cyber Glass Dock Capsule Container -->
    <FrameLayout
        android:id="@+id/floatingDockContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_floating_dock"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:id="@+id/navVault"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_vault"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_vault"
                    app:tint="@color/nav_item_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:text="@string/nav_vault"
                    android:textColor="@color/nav_item_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navDisks"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_disks"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_disks"
                    app:tint="@color/nav_item_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:text="@string/nav_disks"
                    android:textColor="@color/nav_item_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navStego"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_stego"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_stego"
                    app:tint="@color/nav_item_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:text="@string/nav_stego"
                    android:textColor="@color/nav_item_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navServer"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_server"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_sync"
                    app:tint="@color/nav_item_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:text="@string/nav_server"
                    android:textColor="@color/nav_item_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</RelativeLayout>
