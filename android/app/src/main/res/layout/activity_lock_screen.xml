<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/av_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/av_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/av_cyan"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/vault_banner_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/cyber_vault_banner" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_title_locked"
            android:textColor="@color/av_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/lock_status_pin_only"
            android:textColor="@color/av_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPinDisplay"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_cyber_card"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:textColor="@color/av_cyan"
            android:textSize="22sp" />

        <!-- Keypad: 24 keys (0-9, a-f, symbols) in a 4x6 grid, shuffled per screen -->
        <GridLayout
            android:id="@+id/keypadGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="4"
            android:rowCount="6"
            android:useDefaultMargins="true">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex0" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex1" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex2" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex3" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex4" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex5" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex6" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex7" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex8" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex9" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex10" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex11" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex12" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex13" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex14" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex15" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex16" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex17" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex18" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex19" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex20" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex21" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex22" style="@style/HexKey" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHex23" style="@style/HexKey" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKeyClear"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="@string/key_backspace"
                android:textColor="@color/av_danger"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:background="@drawable/bg_neon_button"
                android:stateListAnimator="@null"
                android:text="@string/btn_unlock"
                android:textColor="@color/av_bg"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
