<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/av_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- Top Cyber Vault Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/av_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/av_cyan"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/vault_banner_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/cyber_vault_banner" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_title_locked"
            android:textColor="@color/av_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/lock_status_bio"
            android:textColor="@color/av_text_secondary"
            android:textSize="11sp" />

        <!-- Primary Biometric Action Button (Fingerprint / Face) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrimaryBio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_neon_button"
            android:stateListAnimator="@null"
            android:text="@string/btn_bio_unlock"
            android:textColor="@color/av_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- PIN Dots Neon Box -->
        <TextView
            android:id="@+id/tvPinDisplay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_cyber_card"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.4"
            android:textColor="@color/av_cyan"
            android:textSize="22sp" />

        <!-- Keypad Grid -->
        <GridLayout
            android:id="@+id/keypadGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey1"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="1"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey2"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="2"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey3"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="3"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey4"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="4"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey5"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="5"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey6"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="6"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey7"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="7"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey8"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="8"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey9"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="9"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKeyBio"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="@string/key_bio"
                android:textColor="@color/av_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey0"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="0"
                android:textColor="@color/av_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKeyClear"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_keypad_button"
                android:stateListAnimator="@null"
                android:text="@string/key_backspace"
                android:textColor="@color/av_danger"
                android:textSize="18sp" />

        </GridLayout>

        <!-- Fallback PIN Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_keypad_button"
            android:stateListAnimator="@null"
            android:text="@string/btn_pin_fallback"
            android:textColor="@color/av_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
